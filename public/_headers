# Cabeçalhos no Cloudflare Pages (equivalente aos "headers" do vercel.json).
# Rotas da SPA: sem 404.html o Pages devolve o index.html em qualquer caminho.

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/push-sw.js
  Cache-Control: no-cache
